{
	"name": "matchory-trust-center",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"license": "AGPL-3.0-or-later",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy url preferredLanguage baseLocale",
		"prepare": "pnpm paraglide:compile && svelte-kit sync || echo ''",
		"check": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run --config vitest.config.ts",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.24.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@testcontainers/postgresql": "^12.1.0",
		"@types/node": "^26.4.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.9.1",
		"eslint-plugin-svelte": "^3.23.0",
		"prettier": "^3.9.6",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"openid-client": "^6.8.7",
		"postgres": "^3.4.9",
		"zod": "^4.4.3"
	}
}
