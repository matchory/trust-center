{
	"name": "matchory-trust-center",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"license": "AGPL-3.0-or-later",
	"packageManager": "pnpm@11.9.0",
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
		"dev:up": "docker compose -f compose.dev.yaml up -d --wait",
		"dev:down": "docker compose -f compose.dev.yaml down",
		"build": "vite build",
		"preview": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js preview",
		"db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
		"db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
		"db:migrate:prod": "node --env-file-if-exists=.env tools/migrate.js",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"prepare": "pnpm paraglide:compile && (svelte-kit sync || echo '')",
		"check": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run --config vitest.config.ts",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.24.1",
		"@inlang/plugin-message-format": "4.4.3",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@testcontainers/postgresql": "^12.1.0",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.4.0",
		"@types/nodemailer": "^8.0.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.9.1",
		"eslint-plugin-svelte": "^3.23.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@milkdown/core": "^7.22.1",
		"@milkdown/plugin-listener": "^7.22.1",
		"@milkdown/preset-commonmark": "^7.22.1",
		"@milkdown/theme-nord": "^7.22.1",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/sdk-trace-base": "^2.11.0",
		"@pdf-lib/fontkit": "^1.1.1",
		"drizzle-orm": "^0.45.2",
		"mammoth": "^1.12.2",
		"nodemailer": "^9.0.6",
		"openid-client": "^6.8.7",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^6.3.289",
		"postgres": "^3.4.9",
		"rehype-parse": "^9.0.1",
		"rehype-remark": "^10.0.1",
		"remark-parse": "^11.0.0",
		"remark-stringify": "^11.0.0",
		"unified": "^11.0.5",
		"zod": "^4.4.3"
	}
}
